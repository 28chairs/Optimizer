# HSA/FSA Optimizer Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# AFFILIATE LINKS (Optional)
# =============================================================================

# Affiliate link for HSA account opening
# Example: https://partner.com/hsa?ref=yourcode
NEXT_PUBLIC_AFFILIATE_HSA_URL=

# Affiliate link for high-yield savings accounts
# Example: https://partner.com/hysa?ref=yourcode
NEXT_PUBLIC_AFFILIATE_HYSA_URL=

# =============================================================================
# ANALYTICS (Optional - for future use)
# =============================================================================

# Google Analytics 4 Measurement ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics domain
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
